        "import random\n",
        "# a random number from range 1 to 100 is selected by computer\n",
        "# number to be guessed\n",
        "number=random.randint(1,10)\n",
        "guess=int(input('enter a number'))\n",
        "while guess!=number:\n",
        "  print('incorrect guess')\n",
        "  if guess>number:\n",
        "    print('guess is high')\n",
        "  else:\n",
        "    print('guess is low')\n",
        "  guess=int(input('try one more time: '))\n",
        "print('correct guess\\n you win')\n",
